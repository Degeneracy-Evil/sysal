#!/usr/bin/env bash
# Validate whitespace and formatting in the staged snapshot without modifying it.
set -euo pipefail

git diff --cached --check

mapfile -d '' STAGED < <(git diff --cached --name-only -z --diff-filter=ACMR)
CPP_FILES=()
for path in "${STAGED[@]}"; do
    case "$path" in
        *.h|*.hpp|*.cpp) CPP_FILES+=("$path") ;;
    esac
done

[ "${#CPP_FILES[@]}" -gt 0 ] || exit 0

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format is required to validate staged C/C++ files." >&2
    echo "Install clang-format and retry the commit." >&2
    exit 1
fi

TEMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TEMP_DIR"' EXIT

for path in "${CPP_FILES[@]}"; do
    staged_file="$TEMP_DIR/staged"
    formatted_file="$TEMP_DIR/formatted"
    git cat-file blob ":$path" >"$staged_file"
    clang-format --assume-filename="$path" <"$staged_file" >"$formatted_file"
    if ! cmp -s -- "$staged_file" "$formatted_file"; then
        echo "pre-commit: staged C/C++ formatting validation failed: $path" >&2
        echo "Run 'xmake format', review the result, and stage the intended changes." >&2
        exit 1
    fi
done
